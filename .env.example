# Crozidrone — variables d'environnement du serveur
#
# Copier en .env puis lancer :  uv run uvicorn api.main:app --port 8000 --env-file .env
# Avec Docker :                 docker run --env-file .env -p 8000:8000 crozidrone
#
# Toutes les valeurs ci-dessous sont les valeurs par défaut (commentées) sauf mention contraire.
# Le serveur valide chaque variable au démarrage (services/api/src/api/settings.py) et refuse de
# démarrer si une valeur est invalide. Les durées *_MS sont des entiers > 0 en millisecondes.
# Référence complète : docs/protocol.md

# --- Estimation de distance (②) ---------------------------------------------------------------
# none     : aucune détection (défaut)
# scripted : drone virtuel sur une trajectoire connue, pour tester la chaîne sans drone
# model    : vrai modèle (release du repo ML, voir la section suivante)
# DISTANCE_ESTIMATOR=none

# --- Vrai modèle (DISTANCE_ESTIMATOR=model) ---------------------------------------------------
# Soit un bundle de release local (prioritaire, utile hors ligne) :
# DISTANCE_MODEL_DIR=/chemin/vers/edth.audio.48k-w100.r1
# Soit une release Hugging Face épinglée (sha de commit à 40 caractères, jamais une branche) :
# DISTANCE_MODEL_REPO=ImAPancake/EDTH_Paris26_models
# DISTANCE_MODEL_REVISION=e7a6a5444bb72f08ee9c7dfea00fe78e5a9fbee7
# DISTANCE_MODEL_RELEASE=edth.audio.48k-w100.r1
# Jeton d'accès si le repo est privé (secret : ne jamais committer le .env) :
# HF_TOKEN=
# Cache Hugging Face (dans l'image Docker : /data/hf) :
# HF_HOME=
# Cadence des estimations, multiple du pas de la release (r1 : 20 ms) :
# MODEL_PERIOD_MS=100
# Incertitude relative annoncée avec chaque distance :
# MODEL_UNCERTAINTY=0.10

# --- Temps réel -------------------------------------------------------------------------------
# Fenêtre analysée par le mock scripted (avec model, imposée par la release) :
# DISTANCE_WINDOW_MS=250
# Intervalle entre deux messages de /ws/state :
# STATE_PERIOD_MS=250
# Téléphone affiché "stale" sans paquet depuis :
# STALE_AFTER_MS=1000
# Âge maximal d'une détection considérée comme fraîche :
# DETECTION_FRESH_MS=2000
# Écart maximal entre les détections combinées par la localisation (③) :
# FUSION_SPREAD_MS=500

# --- Piste du drone (③, filtre de Kalman étendu) ----------------------------------------------
# Accélération non modélisée en m/s² (plus grand = plus réactif, plus petit = plus lisse) :
# TRACK_ACCEL_STD=1.0
# Piste perdue sans distance acceptée depuis :
# TRACK_TIMEOUT_MS=1000
# Altitude attendue du drone et sa souplesse (écart-type), en mètres :
# TRACK_ALTITUDE_M=1.5
# TRACK_ALTITUDE_STD_M=0.5
# Rayon d'incertitude au-delà duquel une piste confirmée est abandonnée :
# TRACK_MAX_RADIUS_M=1.0

# --- Drone simulé (DISTANCE_ESTIMATOR=scripted) -----------------------------------------------
# Centre du cercle, décalé depuis le barycentre des téléphones (repère de la salle, mètres) :
# SCRIPTED_OFFSET_EAST_M=0.5
# SCRIPTED_OFFSET_NORTH_M=3.0
# SCRIPTED_RADIUS_M=3.0
# SCRIPTED_ALTITUDE_M=1.5
# Durée d'un tour, en secondes :
# SCRIPTED_PERIOD_S=20
# Portée de détection : au-delà, "pas de drone" :
# SCRIPTED_RANGE_M=5.0
# Incertitude relative annoncée, et bruit gaussien relatif ajouté à chaque distance :
# SCRIPTED_UNCERTAINTY=0.10
# SCRIPTED_NOISE=0

# --- Fichiers ---------------------------------------------------------------------------------
# Enregistrer chaque session en WAV (preuve ; désactivé par défaut) :
# SAVE_SESSIONS=1
# RECORDINGS_DIR=./recordings
# Positions des téléphones (relatif au dossier de lancement) :
# PROFILES_FILE=contracts/profiles.json
# Front buildé servi par FastAPI (défini dans l'image Docker ; en dev, Vite sert le front) :
# FRONT_DIR=web/dist

# --- Serveur de dev Vite (web/) ---------------------------------------------------------------
# Lues par web/vite.config.ts dans l'environnement du shell, PAS depuis ce fichier :
#   CROZIDRONE_BACKEND=http://127.0.0.1:8000        cible du proxy /ws
#   CROZIDRONE_ALLOWED_HOSTS=demo.example.com       hôtes de tunnel en plus de ngrok / *.ts.net
